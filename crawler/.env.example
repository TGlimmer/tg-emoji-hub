# Telegram API 凭据 (my.telegram.org 申请)
# 警告: .env / .session 文件含敏感信息，绝不能提交到 Git
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=tg-emoji-hub

# MySQL 连接（与 Go server 共用同一个 schema）
DB_DSN=mysql+pymysql://tgemoji:change-me@mysql:3306/tg_emoji_hub?charset=utf8mb4

# 路径（容器内挂载点）
CRAWLER_SIGNALS_DIR=/var/signals
THUMBNAIL_DIR=/var/thumbnails
# 原文件目录（webp/webm/tgs 原始资产，前端 /emoji/{id}.{ext} 直读）
MEDIA_DIR=/var/media
SESSION_DIR=/app/.session

# 是否下载 emoji 原文件（0 跳过，仅入元数据 + 缩略图）
DOWNLOAD_ORIGINALS=1

# 全量爬取 cron 表达式（每周日 03:00），crawler 进程不自带 cron，由外部 cron 触发 `python crawler.py full`
CRON_FULL_CRAWL=0 3 * * 0

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# AI 关键词补全（可选，不用此功能可全部留空）
# AI_PROVIDER 默认 gemini（Google Gemini 2.0 Flash，风控宽松、免费 1500 req/天）
# 国内服务器若不便访问 Google 可改 zhipu 退回智谱（但 emoji 图常被 1301 风控跳过）
AI_PROVIDER=gemini
# https://aistudio.google.com/apikey 申请
GEMINI_API_KEY=
# GEMINI_MODEL 默认 gemini-3.5-flash（实测打 emoji 标质量最好）；可选 gemini-2.5-flash / gemini-3-pro-preview
# GEMINI_MODEL=gemini-3.5-flash
#
# HTTPS 代理（国内服务器/部分美国 VPS 直连 Gemini API 报 "User location not supported" 时打开）
# 注意：必须是 HTTP 代理协议（http://），SOCKS5 需要 socks5h://（pip install httpx[socks]）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,mysql,redis
# https://bigmodel.cn/usercenter/apikeys 申请，备选
ZAI_API_KEY=
