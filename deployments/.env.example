# 复制为 deployments/.env 再改。.env 已在 .gitignore 里，别提交。
# 密码只用字母数字（会被拼进 YAML 和数据库连接 URL，特殊字符会弄坏它们）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 对外端口，浏览器和 MCP 客户端都连这个
HTTP_PORT=8080
# 浏览器实际访问的地址，接口返回的缩略图/原图链接会以它开头；上域名后改成 https://你的域名
PUBLIC_URL=http://localhost:8080

LOG_LEVEL=info

# ---- 爬虫（可选，docker compose --profile crawler 才会起）----
# my.telegram.org 申请
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# 0 = 只入元数据和缩略图，不下载 tgs/webm 原文件
DOWNLOAD_ORIGINALS=1

# AI 关键词补全（可选）
AI_PROVIDER=gemini
GEMINI_API_KEY=
ZAI_API_KEY=
# 国内机器访问 Gemini 需要代理
HTTPS_PROXY=
