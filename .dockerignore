# 构建上下文是仓库根目录，下面这些不能进镜像（含凭据 / 体积大 / 本机产物）
.git
.gitignore
.github
.idea
.vscode
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.session
**/*.session-journal
crawler/.session
configs/config.yaml
var
crawler/var
crawler/data
dist
web/dist
web/public/emoji
web/public/thumbs
*.zip
*.exe
*.md
deployments/bare-metal/out
*.pem
*.key
